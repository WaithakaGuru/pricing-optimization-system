# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# Database
DATABASE_URL=sqlite:///./pricing.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/optima

# Redis
REDIS_URL=redis://localhost:6379/0

# RL Training
RL_ENABLED=True
RL_CHECKPOINT_DIR=models/rl_checkpoints
RL_UPDATE_FREQUENCY=3600

# ML Model Paths
PROPHET_MODEL_PATH=models/prophet/model.pkl
XGBOOST_MODEL_PATH=models/xgboost/elasticity.pkl

# Pricing
MIN_PRICE=0.10
MAX_PRICE=10000.00

# External APIs
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# Logging
LOG_LEVEL=INFO

# Experiment Tracking (Weights & Biases)
WANDB_PROJECT=price-optimizer
WANDB_ENTITY=your-entity-name
# WANDB_API_KEY=your-api-key

# Feature Flags
USE_BANDIT=True  # Start with contextual bandit (Phase 1)
USE_PPO=False    # Enable after bootstrapping
USE_SAC=False    # Enable for continuous pricing
